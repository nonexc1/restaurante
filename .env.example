# Copia este archivo como .env y completa los valores.

# ---------- Servidor
PORT=3000
# URL pública HTTPS donde corre el CRM (necesaria para webhooks). Ej: https://micrm.up.railway.app
PUBLIC_URL=
DB_PATH=data/crm.db
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# ---------- Tu negocio
BUSINESS_NAME=Mi Tienda
YAPE_NUMBER=999999999
YAPE_NAME=Nombre del titular
# Adelanto que se pide para envíos a provincia (cubre el envío si el cliente no recoge)
ADVANCE_AMOUNT=20
LIMA_DELIVERY_FEE=10

# ---------- Bot IA (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: modelo y nivel de esfuerzo del bot (low es rápido y económico para chat)
BOT_MODEL=claude-opus-5-5
BOT_EFFORT=low

# ---------- Meta (WhatsApp Cloud API, Facebook Messenger, Instagram) — https://developers.facebook.com
# Token que tú inventas y pegas también en la configuración del webhook de la app
META_VERIFY_TOKEN=inventa-un-texto-largo
# App Secret (Configuración de la app > Básica) para verificar firmas
META_APP_SECRET=
# WhatsApp: token permanente de usuario del sistema + ID del número
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Facebook Messenger: token de acceso de la página
FB_PAGE_TOKEN=
# Instagram: token de la página vinculada a la cuenta de Instagram (si se deja vacío usa FB_PAGE_TOKEN)
IG_TOKEN=
META_GRAPH_VERSION=v21.0

# ---------- Telegram — habla con @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=inventa-otro-texto

# ---------- Shalom — https://shalom-api.lat (API key) + tu cuenta de pro.shalom.pe
SHALOM_API_URL=https://api.shalom-api.lat
SHALOM_API_KEY=
# Se obtienen con: npm run shalom:setup
SHALOM_INSTANCE_ID=
SHALOM_WEBHOOK_SECRET=
# ter_id de la agencia donde dejas los paquetes (ej. una agencia en Lima)
SHALOM_ORIGIN_TERMINAL=
SHALOM_DEFAULT_CONTENT=PAQUETE S
SHALOM_DECLARACION=Electrodomésticos
